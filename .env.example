# Synthetic local development only. Never use these credentials for a live service.
DATABASE_URL=postgresql://bcs_dev:bcs_dev_local@127.0.0.1:5432/bcs_dev
APP_MODE=development
WEB_ORIGIN=http://localhost:3000
PORT=4000
NEXT_PUBLIC_API_BASE=/api/v1
API_INTERNAL_URL=http://127.0.0.1:4000

# Staff authenticator secrets require an independently generated 32-byte key.
# Run node scripts/development-key.mjs after copying this file for local use.
# Inject a separately managed key for a future qualified deployment; never reuse the local key.
# MFA_ENCRYPTION_KEY=
# OTP_HASH_KEY=
# Use separate migration/restore and application credentials for a future deployment.
# MIGRATION_DATABASE_URL=
# Backups require a separately managed 32-byte base64 key; keep it off-host.
# BACKUP_ENCRYPTION_KEY=
# Local backup drill tools may use the pinned existing database container.
# PG_TOOLS_CONTAINER=better-call-sir-dev-db-1

# Optional development private media directory; defaults to .cache/private-evidence.
# EVIDENCE_DIRECTORY=/workspace/better-call-sir/.cache/private-evidence
# Worker ClamAV endpoint. Leave unset to keep uploads quarantined until configured.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Email OTP; no SMS provider. Sandbox returns a labelled development code.
EMAIL_DELIVERY_MODE=sandbox
# Gmail testing: set EMAIL_DELIVERY_MODE=smtp and configure the following.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=youraccount@gmail.com
# SMTP_FROM=youraccount@gmail.com
# SMTP_PASSWORD= (Google app password, never your normal Gmail password)
# PUBLIC_APP_URL=http://localhost:3000
# SMTP_FROM must equal SMTP_USER. Port587 requires SMTP_SECURE=false (mandatory STARTTLS).
# SMTP acceptance is not inbox delivery; uncertain sends are never automatically retried.
# For Resend delivery set EMAIL_DELIVERY_MODE=resend and inject these secrets/config.
# RESEND_API_KEY=
# EMAIL_FROM=signin@your-verified-domain.example
# EMAIL_CONTENT_KEY= (32 random bytes encoded as base64; inject securely)
# EMAIL_WEBHOOK_SECRET= (Resend Svix signing secret; inject securely)
# PUBLIC_APP_URL=https://your-approved-domain.example
# Live delivery remains unqualified; sandbox never delivers to inboxes.

# Razorpay checkout. Sandbox is local and cannot settle money.
PAYMENT_PROVIDER_MODE=sandbox
# Set PAYMENT_PROVIDER_MODE=razorpay and inject these secrets after provider review.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Private online sessions. Sandbox emits non-routable meet.invalid links.
MEETING_PROVIDER_MODE=sandbox
# Set MEETING_PROVIDER_MODE=google-meet and inject a short-lived OAuth token.
# GOOGLE_MEET_ACCESS_TOKEN=

# Private secret-manager mounted versioned MFA keyring; never commit key values.
# MFA_KEYRING_FILE=/private/secrets/mfa-keyring.json

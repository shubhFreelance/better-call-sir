# Synthetic local development only. Never use these credentials for a live service.
DATABASE_URL=postgresql://bcs_dev:bcs_dev_local@127.0.0.1:5432/bcs_dev
APP_MODE=development
WEB_ORIGIN=http://localhost:3000
PORT=4000
NEXT_PUBLIC_API_BASE=/api/v1
API_INTERNAL_URL=http://127.0.0.1:4000

# Optional development private media directory; defaults to .cache/private-evidence.
# EVIDENCE_DIRECTORY=/workspace/better-call-sir/.cache/private-evidence
# Worker ClamAV endpoint. Leave unset to keep uploads quarantined until configured.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Email OTP; no SMS provider. Sandbox returns a labelled development code.
EMAIL_DELIVERY_MODE=sandbox
# For Resend delivery set EMAIL_DELIVERY_MODE=resend and inject these secrets/config.
# RESEND_API_KEY=
# EMAIL_FROM=signin@your-verified-domain.example

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}
model Account {
  registrationIntent String?
  emailLocale String @default("en")
  authVersion Int @default(0)
  id String @id @default(uuid()) @db.Uuid
  phone String? @unique
  email String? @unique
  name String
  role String @default("GUARDIAN")
  verified Boolean @default(false)
  disabled Boolean @default(false)
  region String @default("Raipur")
  createdAt DateTime @default(now())
}
model Otp {
  locale String @default("en")
  id String @id @default(uuid()) @db.Uuid
  address String @unique
  hash String
  expiresAt DateTime
  attempts Int @default(0)
}
model RateBucket {
  key String @id
  count Int
  resetsAt DateTime
  @@index([resetsAt])
}
model Session {
  authVersion Int @default(0)
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  familyId String @db.Uuid
  deviceLabel String? @db.VarChar(60)
  accessHash String @unique
  refreshHash String @unique
  csrf String
  accessExpiresAt DateTime
  expiresAt DateTime
  revoked Boolean @default(false)
  rotated Boolean @default(false)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  mfaVerifiedAt DateTime?
  @@index([accountId])
}
model MfaCredential {
  accountId String @id @db.Uuid
  encryptedSecret String
  enrollmentFamilyId String? @db.Uuid
  enrollmentExpiresAt DateTime?
  enabledAt DateTime?
  lastUsedStep BigInt @default(-1)
  recoveryHashes String[] @default([])
}
model Consent {
  id String @id @default(uuid()) @db.Uuid
  guardianId String @unique @db.Uuid
  purpose String @default("tuition-and-learning-records")
  policyVersion String @default("development-v1")
  grantedAt DateTime @default(now())
  withdrawnAt DateTime?
}
model Child {
  learningManagementMode String @default("GUARDIAN_ONLY")
  learningManagementVersion Int @default(1)
  guardianVerificationId String? @unique @db.Uuid
  educationStage String @default("SCHOOL")
  earlyYearsLevel String?
  courseName String?
  university String?
  studyYear Int?
  schoolName String?
  schoolSubjects String[] @default([])
  version Int @default(1)
  studentAccessRevokedAt DateTime?
  id String @id @default(uuid()) @db.Uuid
  guardianId String @db.Uuid
  alias String
  grade Int?
  board String?
  studentAccountId String? @unique @db.Uuid
  @@index([guardianId])
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  childId String @db.Uuid
  guardianId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
}
model Teacher {
  teachingCoverage Json?
  address Json?
  education Json?
  employment Json?
  demoOptIn Boolean?
  lockInDays Int?
  id String @id @default(uuid()) @db.Uuid
  accountId String @unique @db.Uuid
  slug String @unique
  name String
  headline String
  bio String
  subjects String[]
  boards String[]
  grades Int[]
  languages String[]
  modes String[]
  localities String[]
  monthlyPaise Int
  experience Int @default(0)
  status String @default("SUBMITTED")
  screeningComplete Boolean @default(false)
  screeningValidUntil DateTime?
  profileRevision Int @default(1)
  feePolicyVersion String @default("pilot-v1")
  feeTermsAcceptedAt DateTime?
  region String @default("Raipur")
  maxActiveStudents Int @default(10)
  travelAccepted Boolean @default(false)
  consultationOptIn Boolean @default(false)
  version Int @default(1)
  avatarColor String @default("#e4eee5")
  @@index([status])
}
model TuitionRequest {
  guardianDecisionRequested Boolean @default(false)
  rematchFromPlacementId String? @unique @db.Uuid
  discoveryMethod String @default("ASSISTED")
  preferredTeacherId String? @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  guardianId String @db.Uuid
  childId String @db.Uuid
  subject String
  mode String
  language String
  locality String
  budgetPaise Int
  schedule String
  region String @default("Raipur")
  schedulePreferences Json?
  scheduleStatus String @default("UNCONFIRMED")
  matchStatus String @default("PENDING")
  selectedCandidateId String? @db.Uuid
  status String @default("OPEN")
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([guardianId, status])
}
model Recommendation {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  teacherId String @db.Uuid
  score Int
  reasons String[]
  rankerVersion String @default("rules-v1")
  response String @default("PENDING")
  version Int @default(1)
  runId String? @db.Uuid
  expiresAt DateTime?
  presentedAt DateTime?
  position Int?
  @@unique([requestId, teacherId])
}
model Reservation {
  provider String @default("INTERNAL")
  source String @default("INTERNAL")
  sourceId String? @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  teacherId String @db.Uuid
  guardianId String @db.Uuid
  childId String? @db.Uuid
  kind String
  startsAt DateTime
  endsAt DateTime
  status String @default("HOLD")
  expiresAt DateTime?
  version Int @default(1)
  topic String @default("")
  subject String @default("Maths")
  language String @default("English")
  pricePolicyVersion String @default("revision-dev-v1-zero-platform-fee")
  payablePaise Int @default(0)
  scopeAccepted Boolean @default(false)
  amountPaise Int @default(0)
  createdAt DateTime @default(now())
  @@index([guardianId])
  @@index([teacherId, startsAt])
  @@index([status, expiresAt])
}
model Meeting {
  id String @id @default(uuid()) @db.Uuid
  reservationId String @unique @db.Uuid
  provider String @default("GOOGLE_MEET")
  providerMode String
  providerSpaceId String? @unique
  joinUrl String?
  status String @default("PENDING")
  failureCode String?
  retryAt DateTime?
  attempts Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, retryAt])
}
model Placement {
  familyAcceptanceActorId String? @db.Uuid
  placementFeePaise Int?
  commercialVersion Int @default(0)
  startedAt DateTime?
  closedAt DateTime?
  id String @id @default(uuid()) @db.Uuid
  guardianId String @db.Uuid
  teacherId String @db.Uuid
  childId String @db.Uuid
  requestId String @unique @db.Uuid
  monthlyPaise Int
  policyVersion String @default("pilot-v1")
  guardianAccepted Boolean @default(false)
  teacherAccepted Boolean @default(false)
  guardianStarted Boolean @default(false)
  teacherReceiptConfirmed Boolean @default(false)
  status String @default("TERMS_PENDING")
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([guardianId, status])
}
model ContinuationObservation {
 id String @id @default(uuid()) @db.Uuid
 placementId String @unique @db.Uuid
 dueAt DateTime
 observedAt DateTime @default(now())
 continued Boolean?
 @@index([dueAt])
}
model Invoice {
  id String @id @default(uuid()) @db.Uuid
  placementId String @unique @db.Uuid
  payerId String @db.Uuid
  amountPaise Int
  currency String @default("INR")
  policyVersion String
  status String @default("DUE")
  version Int @default(1)
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  reservationId String? @unique @db.Uuid
  invoiceId String? @unique @db.Uuid
  checkoutOrderId String? @unique @db.Uuid
  providerEventId String @unique
  amountPaise Int
  currency String @default("INR")
  status String @default("CAPTURED")
  createdAt DateTime @default(now())
}
model CheckoutOrder {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  kind String
  resourceId String @db.Uuid
  amountPaise Int
  currency String @default("INR")
  provider String @default("RAZORPAY")
  providerMode String
  providerOrderId String? @unique
  status String @default("CREATING")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}
model Refund {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @unique @db.Uuid
  amountPaise Int
  status String @default("PENDING")
  reason String
  createdAt DateTime @default(now())
}
model Lesson {
  recurringScheduleId String? @db.Uuid
  id String @id @default(uuid()) @db.Uuid
